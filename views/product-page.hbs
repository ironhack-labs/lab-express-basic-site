<div class="container mt-5">
    <h1>Products</h1>
    <hr>
    <div class="row">

        {{#each products}}

        <div class="col-md-4 mb-3">
            <div class="card">
                <img src="{{images}}" class="card-img-top" alt="{{title}}">
                <div class="card-body">
                    <h5 class="card-title">{{title}} {{price}}</h5>
                    <p class="card-text">Producto: {{description}}</p>
                </div>
            </div>
        </div>



        {{/each}}

    </div>
    <hr>
    <a href="/" class="btn btn-dark">Ir a inicio</a>
</div>